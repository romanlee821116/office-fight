# 複製成 server/.env 後填入（.env 已被 gitignore，不會進版控）
# 未填 = 會員登入功能停用，遊戲維持匿名模式照常運作

# Neon Postgres 連線字串，記得保留 ?sslmode=require
DATABASE_URL=

# session / OAuth state 簽章密鑰，自己產一組：openssl rand -base64 32
AUTH_SECRET=

# Google Cloud → API 和服務 → 憑證 → OAuth 用戶端
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 組 redirect_uri 用，必須與 Google 後台登記的重新導向 URI 同源
# 本機開發填 http://localhost:5173（vite 會把 /api 轉給 2567）
# 正式站填 https://<你的-render-域名>
PUBLIC_ORIGIN=http://localhost:5173

# 選填：只允許這個 Google Workspace 網域登入
GOOGLE_ALLOWED_HD=

# 進場密碼（沿用既有設定，留空代表不需要密碼）
JOIN_CODE=
